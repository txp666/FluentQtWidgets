GalleryInterface {
    background-color: transparent;
}

GalleryInterface #view {
    background-color: transparent;
}

GalleryInterface #galleryToolBar {
    background-color: transparent;
}

GalleryInterface #card {
    border: 1px solid rgb(36, 36, 36);
    border-radius: 10px;
    background-color: rgba(0, 0, 0, 0.1795);
}

GalleryInterface #card QLabel {
    font: 14px --FontFamilies;
    color: white;
}

GalleryInterface #sourceWidget {
    background-color: rgba(255, 255, 255, 0.09);
    border-top: 1px solid rgb(36, 36, 36);
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

QScrollArea {
    border: none;
}

ExampleCard {
    background-color: transparent;
}

TitleLabel,
StrongBodyLabel {
    color: white;
}

ExampleCard > #card InfoBadge {
    font-size: 11px;
}
