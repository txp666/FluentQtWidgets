    border: none;
    background: transparent;
}

QLabel#titleLabel {
    font: 14px --FontFamilies;
    font-weight: bold;
    color: white;
    background-color: transparent;
}

QLabel#contentLabel {
    font: 14px --FontFamilies;
    color: white;
    background-color: transparent;
