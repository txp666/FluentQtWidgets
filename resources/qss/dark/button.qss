    min-height: 32px;
    padding: 5px 9px 6px 8px;
}

QPushButton[fqw="PushButton"][isPlaceholderText="true"] {
    color: rgba(255, 255, 255, 0.6063);
}

QPushButton[fqw="PushButton"][hasIcon="false"],
QPushButton[fqw="TogglePushButton"][hasIcon="false"],
