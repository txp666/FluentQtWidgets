QToolButton[fqw="TransparentToggleToolButton"]:pressed,
QToolButton[fqw="PillToolButton"]:pressed,
QToolButton[fqw="FolderRemoveButton"]:pressed,
QToolButton[fqw="SplitDropButton"]:pressed {
    color: rgba(255, 255, 255, 0.786);
    background: rgba(255, 255, 255, 0.0326);
    border-top: 1px solid rgba(255, 255, 255, 0.053);
}

QPushButton[fqw="PushButton"]:disabled,
QPushButton[fqw="DropDownPushButton"]:disabled,
QPushButton[fqw="TogglePushButton"]:disabled,
QPushButton[fqw="TransparentPushButton"]:disabled,
QPushButton[fqw="TransparentDropDownPushButton"]:disabled,
QPushButton[fqw="TransparentTogglePushButton"]:disabled,
QPushButton[fqw="PillPushButton"]:disabled,
QToolButton[fqw="ToolButton"]:disabled,
QToolButton[fqw="DropDownToolButton"]:disabled,
QToolButton[fqw="ToggleToolButton"]:disabled,
