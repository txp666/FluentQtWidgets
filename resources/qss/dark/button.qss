QToolButton[fqw="TransparentDropDownToolButton"]:disabled,
QToolButton[fqw="TransparentToggleToolButton"]:disabled,
QToolButton[fqw="PillToolButton"]:disabled,
QToolButton[fqw="FolderRemoveButton"]:disabled,
QToolButton[fqw="SplitDropButton"]:disabled {
    color: rgba(255, 255, 255, 0.3628);
    background: rgba(255, 255, 255, 0.0419);
    border: 1px solid rgba(255, 255, 255, 0.053);
    border-top: 1px solid rgba(255, 255, 255, 0.053);
}

#splitPushButton:pressed,
#splitToolButton:pressed,
QToolButton[fqw="SplitDropButton"]:pressed {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
}

QPushButton[fqw="PrimaryPushButton"],
QPushButton[fqw="PrimaryDropDownPushButton"],
QToolButton[fqw="PrimaryToolButton"],
QToolButton[fqw="PrimaryDropDownToolButton"],
QToolButton[fqw="PrimarySplitDropButton"],
QPushButton[fqw="TogglePushButton"]:checked,
QPushButton[fqw="TransparentTogglePushButton"]:checked,
QToolButton[fqw="ToggleToolButton"]:checked,
QToolButton[fqw="TransparentToggleToolButton"]:checked {
    color: black;
    background-color: @accentColor;
    border: 1px solid --ThemeColorLight1;
    border-bottom: 1px solid --ThemeColorLight2;
    border-radius: 5px;
    padding: 5px 12px 6px 12px;
    outline: none;
}

QPushButton[fqw="PrimaryPushButton"]:hover,
QPushButton[fqw="PrimaryDropDownPushButton"]:hover,
QToolButton[fqw="PrimaryToolButton"]:hover,
QToolButton[fqw="PrimaryDropDownToolButton"]:hover,
QToolButton[fqw="PrimarySplitDropButton"]:hover,
QPushButton[fqw="TogglePushButton"]:checked:hover,
QPushButton[fqw="TransparentTogglePushButton"]:checked:hover,
QToolButton[fqw="ToggleToolButton"]:checked:hover,
QToolButton[fqw="TransparentToggleToolButton"]:checked:hover {
    background-color: --ThemeColorDark1;
    border: 1px solid --ThemeColorLight1;
    border-bottom: 1px solid --ThemeColorLight2;
}

QPushButton[fqw="PrimaryPushButton"]:pressed,
QPushButton[fqw="PrimaryDropDownPushButton"]:pressed,
QToolButton[fqw="PrimaryToolButton"]:pressed,
QToolButton[fqw="PrimaryDropDownToolButton"]:pressed,
QToolButton[fqw="PrimarySplitDropButton"]:pressed,
QPushButton[fqw="TogglePushButton"]:checked:pressed,
QPushButton[fqw="TransparentTogglePushButton"]:checked:pressed,
QToolButton[fqw="ToggleToolButton"]:checked:pressed,
QToolButton[fqw="TransparentToggleToolButton"]:checked:pressed {
    color: rgba(0, 0, 0, 0.63);
    background-color: --ThemeColorDark2;
    border: 1px solid --ThemeColorDark2;
}

QPushButton[fqw="PrimaryPushButton"]:disabled,
QPushButton[fqw="PrimaryDropDownPushButton"]:disabled,
QToolButton[fqw="PrimaryToolButton"]:disabled,
QToolButton[fqw="PrimaryDropDownToolButton"]:disabled,
QToolButton[fqw="PrimarySplitDropButton"]:disabled,
QPushButton[fqw="TogglePushButton"]:checked:disabled,
QPushButton[fqw="TransparentTogglePushButton"]:checked:disabled,
QToolButton[fqw="ToggleToolButton"]:checked:disabled,
QToolButton[fqw="TransparentToggleToolButton"]:checked:disabled {
    color: rgba(255, 255, 255, 0.43);
    background-color: rgb(52, 52, 52);
    border: 1px solid rgb(52, 52, 52);
}

QPushButton[fqw="TogglePushButton"][hasIcon="true"]:checked,
QPushButton[fqw="TogglePushButton"][hasIcon="true"]:checked:hover,
QPushButton[fqw="TogglePushButton"][hasIcon="true"]:checked:pressed,
QPushButton[fqw="TogglePushButton"][hasIcon="true"]:checked:disabled,
QPushButton[fqw="TransparentTogglePushButton"][hasIcon="true"]:checked,
QPushButton[fqw="TransparentTogglePushButton"][hasIcon="true"]:checked:hover,
QPushButton[fqw="TransparentTogglePushButton"][hasIcon="true"]:checked:pressed,
QPushButton[fqw="TransparentTogglePushButton"][hasIcon="true"]:checked:disabled {
    padding: 5px 12px 6px 36px;
}

QToolButton[fqw="SplitDropButton"],
QToolButton[fqw="PrimarySplitDropButton"] {
    padding: 0;
    border-left: none;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
}

#splitPushButton,
#splitToolButton,
#primarySplitPushButton,
#primarySplitToolButton {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-right-color: rgba(255, 255, 255, 0.08);
}

#primarySplitPushButton,
#primarySplitToolButton {
    border-right-color: --ThemeColorDark3;
}

#primarySplitPushButton:pressed,
#primarySplitToolButton:pressed {
    border-right: 1px solid --ThemeColorLight2;
}

QPushButton[fqw="HyperlinkButton"] {
    padding: 5px 12px 6px 12px;
    color: @accentColor;
    border: none;
    border-radius: 6px;
    background-color: transparent;
}

QPushButton[fqw="HyperlinkButton"][hasIcon="false"] {
    padding: 5px 12px 6px 12px;
}

QPushButton[fqw="HyperlinkButton"][hasIcon="true"] {
    padding: 5px 12px 6px 36px;
}

QPushButton[fqw="HyperlinkButton"]:hover {
    color: @accentColor;
    background-color: rgba(255, 255, 255, 10);
    border: none;
}

QPushButton[fqw="HyperlinkButton"]:pressed {
    color: --ThemeColorDark1;
    background-color: rgba(255, 255, 255, 7);
    border: none;
}

QPushButton[fqw="HyperlinkButton"]:disabled {
    color: rgba(255, 255, 255, 0.43);
    background-color: transparent;
    border: none;
}

QPushButton[fqw="TransparentPushButton"],
QPushButton[fqw="TransparentDropDownPushButton"],
QPushButton[fqw="TransparentTogglePushButton"],
QToolButton[fqw="TransparentToolButton"],
QToolButton[fqw="TransparentToggleToolButton"],
QToolButton[fqw="TransparentDropDownToolButton"] {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    margin: 0;
}

QPushButton[fqw="TransparentPushButton"]:hover,
QPushButton[fqw="TransparentDropDownPushButton"]:hover,
QPushButton[fqw="TransparentTogglePushButton"]:hover,
QToolButton[fqw="TransparentToolButton"]:hover,
QToolButton[fqw="TransparentToggleToolButton"]:hover,
QToolButton[fqw="TransparentDropDownToolButton"]:hover {
    background-color: rgba(255, 255, 255, 9);
    border: none;
}

QPushButton[fqw="TransparentPushButton"]:pressed,
QPushButton[fqw="TransparentDropDownPushButton"]:pressed,
QPushButton[fqw="TransparentTogglePushButton"]:pressed,
QToolButton[fqw="TransparentToolButton"]:pressed,
QToolButton[fqw="TransparentToggleToolButton"]:pressed,
QToolButton[fqw="TransparentDropDownToolButton"]:pressed {
    background-color: rgba(255, 255, 255, 6);
    border: none;
}

QPushButton[fqw="TransparentPushButton"]:disabled,
QPushButton[fqw="TransparentDropDownPushButton"]:disabled,
QPushButton[fqw="TransparentTogglePushButton"]:disabled,
QToolButton[fqw="TransparentToolButton"]:disabled,
QToolButton[fqw="TransparentToggleToolButton"]:disabled,
QToolButton[fqw="TransparentDropDownToolButton"]:disabled {
    color: rgba(255, 255, 255, 0.3628);
    background-color: transparent;
    border: none;
}

QPushButton[fqw="PillPushButton"],
QPushButton[fqw="PillPushButton"]:hover,
QPushButton[fqw="PillPushButton"]:pressed,
QPushButton[fqw="PillPushButton"]:disabled,
QPushButton[fqw="PillPushButton"]:checked,
QPushButton[fqw="PillPushButton"]:checked:hover,
