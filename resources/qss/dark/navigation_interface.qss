QFrame[fqw="NavigationInterface"] QListWidget#NavigationList {
    border: none;
    background: #262626;
    padding: 8px;
}

QFrame[fqw="NavigationInterface"] QListWidget#NavigationList::item {
    min-height: 36px;
    padding: 4px 10px;
    border-radius: 6px;
}

QFrame[fqw="NavigationInterface"] QListWidget#NavigationList::item:selected {
    background: #343434;
    border-left: 3px solid @accentColor;
}

QFrame[fqw="NavigationPanel"][menu=true] {
    background-color: rgb(32, 32, 32);
    border: 1px solid rgb(57, 57, 57);
    border-left: none;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
}

QFrame[fqw="NavigationPanel"][menu=false] {
    background-color: transparent;
    border: 1px solid transparent;
    border-left: none;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
}

QFrame[fqw="NavigationPanel"][transparent=true] {
    background-color: transparent;
}

QWidget[fqw="NavigationBar"] {
    background: transparent;
}

QWidget[fqw="NavigationSpacer"] {
    background-color: rgb(32, 32, 32);
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
}

QWidget[fqw="NavigationScrollWidget"] {
    background: transparent;
}

QFrame[fqw="NavigationSeparator"] {
    border: none;
    background: transparent;
    margin: 4px 8px;
    max-height: 1px;
    border-top: 1px solid #3d3d3d;
}
