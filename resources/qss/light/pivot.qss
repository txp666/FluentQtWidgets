QWidget[fqw="Pivot"],
QWidget[fqw="SegmentedWidget"],
QWidget[fqw="BreadcrumbBar"] {
    background: transparent;
}

QPushButton[fqw="PivotItem"],
QPushButton[fqw="SegmentedItem"],
QPushButton[fqw="BreadcrumbItem"] {
    min-height: 32px;
    padding: 5px 12px;
    border: 1px solid transparent;
    border-radius: 5px;
    background: transparent;
    color: black;
}

QPushButton[fqw="PivotItem"]:hover,
QPushButton[fqw="SegmentedItem"]:hover,
QPushButton[fqw="BreadcrumbItem"]:hover {
    background: #f3f3f3;
}

QPushButton[fqw="PivotItem"]:checked,
QPushButton[fqw="SegmentedItem"]:checked {
    background: #e8f1fb;
    border-bottom: 2px solid @accentColor;
}

QPushButton[fqw="SegmentedItem"] {
    border: 1px solid #d1d1d1;
}
