QWidget[fqw="TabWidget"],
QWidget[fqw="TabBar"] {
    background: transparent;
}

QPushButton[fqw="TabItem"] {
    min-width: 64px;
    min-height: 34px;
    padding: 5px 32px 5px 12px;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
    text-align: left;
}

QPushButton[fqw="TabItem"]:hover {
    background: #f3f3f3;
}

QPushButton[fqw="TabItem"]:checked,
QPushButton[fqw="TabItem"][selected="true"] {
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-bottom: 2px solid @accentColor;
}

QPushButton[fqw="TabItem"]:disabled {
    color: #a0a0a0;
}

QToolButton[fqw="TabCloseButton"] {
    min-width: 24px;
    min-height: 24px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 5px;
    background: transparent;
}

QToolButton[fqw="TabCloseButton"]:hover {
    background: #e9e9e9;
}

QToolButton[fqw="TabAddButton"] {
    min-width: 32px;
    min-height: 28px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 5px;
    background: transparent;
}

QToolButton[fqw="TabAddButton"]:hover,
QToolButton[fqw="TabScrollButton"]:hover {
    background: #f3f3f3;
}

QToolButton[fqw="TabScrollButton"] {
    min-width: 28px;
    min-height: 28px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 5px;
    background: transparent;
}
