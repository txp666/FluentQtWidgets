    min-height: 24px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 5px;
    background: transparent;
}

QToolButton[fqw="TabCloseButton"]:hover {
    background: #e9e9e9;
}

QRadioButton[fqw="RadioButton"] {
    min-height: 24px;
    max-height: 24px;
    background-color: transparent;
    font: 14px --FontFamilies;
    color: black;
    spacing: 8px;
}

QRadioButton[fqw="RadioButton"]::indicator {
    width: 18px;
    height: 18px;
    border-radius: 11px;
    border: 2px solid #999999;
    background-color: rgba(0, 0, 0, 5);
    margin-right: 4px;
}

QRadioButton[fqw="RadioButton"]::indicator:hover {
    background-color: rgba(0, 0, 0, 0);
}

QRadioButton[fqw="RadioButton"]::indicator:pressed {
    border: 2px solid #bbbbbb;
    background-color: qradialgradient(spread:pad, cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
            stop:0 rgb(255, 255, 255),
            stop:0.5 rgb(255, 255, 255),
            stop:0.6 rgb(225, 224, 223),
            stop:1 rgb(225, 224, 223));
}

QRadioButton[fqw="RadioButton"]::indicator:checked {
    height: 22px;
    width: 22px;
    border: none;
    border-radius: 11px;
    background-color: qradialgradient(spread:pad, cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
            stop:0 rgb(255, 255, 255),
            stop:0.5 rgb(255, 255, 255),
            stop:0.6 @accentColor,
            stop:1 @accentColor);
}

QRadioButton[fqw="RadioButton"]::indicator:checked:hover {
    background-color: qradialgradient(spread:pad, cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
            stop:0 rgb(255, 255, 255),
            stop:0.6 rgb(255, 255, 255),
            stop:0.7 @accentColor,
            stop:1 @accentColor);
}

QRadioButton[fqw="RadioButton"]::indicator:checked:pressed {
    background-color: qradialgradient(spread:pad, cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
            stop:0 rgb(255, 255, 255),
            stop:0.5 rgb(255, 255, 255),
            stop:0.6 @accentColor,
            stop:1 @accentColor);
}

QRadioButton[fqw="RadioButton"]:disabled {
    color: rgba(0, 0, 0, 110);
}

QRadioButton[fqw="RadioButton"]::indicator:disabled {
    border: 2px solid #bbbbbb;
    background-color: transparent;
}

QRadioButton[fqw="RadioButton"]::indicator:disabled:checked {
    border: none;
    background-color: qradialgradient(spread:pad, cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
            stop:0 rgb(255, 255, 255),
            stop:0.5 rgb(255, 255, 255),
            stop:0.6 rgba(0, 0, 0, 0.2169),
            stop:1 rgba(0, 0, 0, 0.2169));
}

