QSpinBox[fqw="SpinBox"],
QDoubleSpinBox[fqw="DoubleSpinBox"],
QDateEdit[fqw="DateEdit"],
QDateTimeEdit[fqw="DateTimeEdit"],
QTimeEdit[fqw="TimeEdit"],
QSpinBox[fqw="CompactSpinBox"],
QDoubleSpinBox[fqw="CompactDoubleSpinBox"],
QDateEdit[fqw="CompactDateEdit"],
QDateTimeEdit[fqw="CompactDateTimeEdit"],
QTimeEdit[fqw="CompactTimeEdit"] {
    color: black;
    background-color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(0, 0, 0, 13);
    border-bottom: 1px solid rgba(0, 0, 0, 100);
    border-radius: 5px;
    padding: 0px 80px 0 10px;
    selection-background-color: --ThemeColorLight1;
}

QSpinBox[fqw="CompactSpinBox"],
QDoubleSpinBox[fqw="CompactDoubleSpinBox"],
QDateEdit[fqw="CompactDateEdit"],
QDateTimeEdit[fqw="CompactDateTimeEdit"],
QTimeEdit[fqw="CompactTimeEdit"] {
    padding: 0px 26px 0 10px;
}

QSpinBox[fqw="SpinBox"]:read-only,
QDoubleSpinBox[fqw="DoubleSpinBox"]:read-only,
QDateEdit[fqw="DateEdit"]:read-only,
QDateTimeEdit[fqw="DateTimeEdit"]:read-only,
QTimeEdit[fqw="TimeEdit"]:read-only,
QSpinBox[fqw="CompactSpinBox"]:read-only,
QDoubleSpinBox[fqw="CompactDoubleSpinBox"]:read-only,
QDateEdit[fqw="CompactDateEdit"]:read-only,
QDateTimeEdit[fqw="CompactDateTimeEdit"]:read-only,
QTimeEdit[fqw="CompactTimeEdit"]:read-only,
QSpinBox[fqw="SpinBox"][symbolVisible="false"],
QDoubleSpinBox[fqw="DoubleSpinBox"][symbolVisible="false"],
QDateEdit[fqw="DateEdit"][symbolVisible="false"],
QDateTimeEdit[fqw="DateTimeEdit"][symbolVisible="false"],
QTimeEdit[fqw="TimeEdit"][symbolVisible="false"],
QSpinBox[fqw="CompactSpinBox"][symbolVisible="false"],
QDoubleSpinBox[fqw="CompactDoubleSpinBox"][symbolVisible="false"],
QDateEdit[fqw="CompactDateEdit"][symbolVisible="false"],
QDateTimeEdit[fqw="CompactDateTimeEdit"][symbolVisible="false"],
QTimeEdit[fqw="CompactTimeEdit"][symbolVisible="false"] {
    padding: 0px 10px 0 10px;
}

QSpinBox[fqw="SpinBox"]:hover,
QDoubleSpinBox[fqw="DoubleSpinBox"]:hover,
QDateEdit[fqw="DateEdit"]:hover,
QDateTimeEdit[fqw="DateTimeEdit"]:hover,
QTimeEdit[fqw="TimeEdit"]:hover,
QSpinBox[fqw="CompactSpinBox"]:hover,
QDoubleSpinBox[fqw="CompactDoubleSpinBox"]:hover,
QDateEdit[fqw="CompactDateEdit"]:hover,
QDateTimeEdit[fqw="CompactDateTimeEdit"]:hover,
QTimeEdit[fqw="CompactTimeEdit"]:hover {
    background-color: rgba(249, 249, 249, 0.5);
    border: 1px solid rgba(0, 0, 0, 13);
    border-bottom: 1px solid rgba(0, 0, 0, 100);
}

QSpinBox[fqw="SpinBox"]:focus,
QDoubleSpinBox[fqw="DoubleSpinBox"]:focus,
QDateEdit[fqw="DateEdit"]:focus,
QDateTimeEdit[fqw="DateTimeEdit"]:focus,
QTimeEdit[fqw="TimeEdit"]:focus,
QSpinBox[fqw="CompactSpinBox"]:focus,
QDoubleSpinBox[fqw="CompactDoubleSpinBox"]:focus,
QDateEdit[fqw="CompactDateEdit"]:focus,
QDateTimeEdit[fqw="CompactDateTimeEdit"]:focus,
QTimeEdit[fqw="CompactTimeEdit"]:focus {
    border-bottom: 1px solid rgba(0, 0, 0, 13);
    background-color: white;
}

QSpinBox[fqw="SpinBox"]:disabled,
QDoubleSpinBox[fqw="DoubleSpinBox"]:disabled,
QDateEdit[fqw="DateEdit"]:disabled,
QDateTimeEdit[fqw="DateTimeEdit"]:disabled,
QTimeEdit[fqw="TimeEdit"]:disabled,
QSpinBox[fqw="CompactSpinBox"]:disabled,
QDoubleSpinBox[fqw="CompactDoubleSpinBox"]:disabled,
QDateEdit[fqw="CompactDateEdit"]:disabled,
QDateTimeEdit[fqw="CompactDateTimeEdit"]:disabled,
QTimeEdit[fqw="CompactTimeEdit"]:disabled {
    color: rgba(0, 0, 0, 92);
    background-color: rgba(249, 249, 249, 0.5);
    border: 1px solid rgba(0, 0, 0, 13);
    border-bottom: 1px solid rgba(0, 0, 0, 13);
}

QToolButton[fqw="SpinButton"],
QToolButton[fqw="CompactSpinButton"] {
    background-color: transparent;
    border-radius: 4px;
    border: none;
    margin: 0;
}

QToolButton[fqw="SpinButton"]:hover {
    background-color: rgba(0, 0, 0, 9);
}

QToolButton[fqw="SpinButton"]:pressed {
    background-color: rgba(0, 0, 0, 6);
}
