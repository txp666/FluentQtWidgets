QTableView[fqw="TableView"],
QTableView[fqw="TableWidget"],
QTableWidget[fqw="TableWidget"] {
    background: transparent;
    outline: none;
    border: none;
    selection-background-color: transparent;
    alternate-background-color: transparent;
    gridline-color: transparent;
}

QTableView[fqw="TableView"][isBorderVisible="true"],
QTableView[fqw="TableWidget"][isBorderVisible="true"],
QTableWidget[fqw="TableWidget"][isBorderVisible="true"] {
    border: 1px solid rgba(0, 0, 0, 0.059);
}

QTableView[fqw="TableView"]::item,
QTableView[fqw="TableWidget"]::item,
QTableWidget[fqw="TableWidget"]::item {
    height: 35px;
    padding-left: 16px;
    padding-right: 16px;
    border: none;
    background: transparent;
}

QTableView[fqw="TableView"]::indicator,
QTableView[fqw="TableWidget"]::indicator,
QTableWidget[fqw="TableWidget"]::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: none;
    background-color: transparent;
}

QHeaderView {
    background-color: transparent;
}

QHeaderView::section {
    background-color: transparent;
    color: rgb(96, 96, 96);
    padding-left: 5px;
    padding-right: 5px;
    border: 1px solid rgba(0, 0, 0, 0.059);
    font: 13px --FontFamilies;
}

QHeaderView::section:horizontal {
    border-left: none;
    height: 33px;
}

QTableView[fqw="TableView"][isBorderVisible="true"] QHeaderView::section:horizontal,
QTableView[fqw="TableWidget"][isBorderVisible="true"] QHeaderView::section:horizontal,
QTableWidget[fqw="TableWidget"][isBorderVisible="true"] QHeaderView::section:horizontal {
    border-top: none;
}

QHeaderView::section:horizontal:last {
    border-right: none;
}

QHeaderView::section:vertical {
    border-top: none;
}

QHeaderView::section:checked {
    background-color: transparent;
}

QHeaderView::down-arrow {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    margin-right: 6px;
    image: url(:/qfluentwidgets/images/table_view/Down_black.svg);
}

QHeaderView::up-arrow {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    margin-right: 6px;
    image: url(:/qfluentwidgets/images/table_view/Up_black.svg);
}

QTableCornerButton::section {
    background-color: transparent;
    border: 1px solid rgba(0, 0, 0, 0.059);
}

QTableCornerButton::section:pressed {
    background-color: rgba(0, 0, 0, 12);
}
