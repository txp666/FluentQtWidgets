QLineEdit[fqw="LineEdit"],
QLineEdit[fqw="AcrylicLineEdit"],
QLineEdit[fqw="SearchLineEdit"],
QLineEdit[fqw="AcrylicSearchLineEdit"],
QLineEdit[fqw="PasswordLineEdit"],
QTextEdit[fqw="TextEdit"],
QPlainTextEdit[fqw="PlainTextEdit"],
QTextBrowser[fqw="TextBrowser"] {
    color: black;
    font: 14px --FontFamilies;
    min-height: 32px;
    border: 1px solid rgba(0, 0, 0, 13);
    border-bottom: 1px solid rgba(0, 0, 0, 100);
    border-radius: 5px;
    padding: 0px 10px;
    background-color: rgba(255, 255, 255, 0.7);
    selection-background-color: --ThemeColorLight1;
}

QTextEdit[fqw="TextEdit"],
QPlainTextEdit[fqw="PlainTextEdit"],
QTextBrowser[fqw="TextBrowser"] {
    padding: 2px 3px 2px 8px;
}

QLineEdit[fqw="LineEdit"]:hover,
QLineEdit[fqw="AcrylicLineEdit"]:hover,
QLineEdit[fqw="SearchLineEdit"]:hover,
QLineEdit[fqw="AcrylicSearchLineEdit"]:hover,
QLineEdit[fqw="PasswordLineEdit"]:hover,
QTextEdit[fqw="TextEdit"]:hover,
QPlainTextEdit[fqw="PlainTextEdit"]:hover,
QTextBrowser[fqw="TextBrowser"]:hover {
    background-color: rgba(249, 249, 249, 0.5);
}

QLineEdit[fqw="LineEdit"]:focus,
QLineEdit[fqw="AcrylicLineEdit"]:focus,
QLineEdit[fqw="SearchLineEdit"]:focus,
QLineEdit[fqw="AcrylicSearchLineEdit"]:focus,
QLineEdit[fqw="PasswordLineEdit"]:focus {
    border-bottom: 1px solid rgba(0, 0, 0, 13);
    background-color: white;
}

QTextEdit[fqw="TextEdit"]:focus,
QPlainTextEdit[fqw="PlainTextEdit"]:focus,
QTextBrowser[fqw="TextBrowser"]:focus {
    border-bottom: 1px solid @accentColor;
    background-color: white;
}

QLineEdit[fqw="LineEdit"]:disabled,
QLineEdit[fqw="AcrylicLineEdit"]:disabled,
QLineEdit[fqw="SearchLineEdit"]:disabled,
QLineEdit[fqw="AcrylicSearchLineEdit"]:disabled,
QLineEdit[fqw="PasswordLineEdit"]:disabled,
QTextEdit[fqw="TextEdit"]:disabled,
QPlainTextEdit[fqw="PlainTextEdit"]:disabled,
QTextBrowser[fqw="TextBrowser"]:disabled {
    color: rgba(0, 0, 0, 92);
    background-color: rgba(249, 249, 249, 0.3);
    border: 1px solid rgba(0, 0, 0, 13);
    border-bottom: 1px solid rgba(0, 0, 0, 13);
}

#lineEditButton {
    background-color: transparent;
    border-radius: 4px;
    border: none;
    margin: 0;
}

#lineEditButton:hover {
    background-color: rgba(0, 0, 0, 9);
}

#lineEditButton:pressed {
    background-color: rgba(0, 0, 0, 6);
}
