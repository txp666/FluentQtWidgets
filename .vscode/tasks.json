{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Configure Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "ninja-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "args": [
          "--preset",
          "mingw-debug"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "Gallery: Build",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "debug",
        "--target",
        "FluentQtWidgetsGallery",
        "--parallel"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake: Configure Debug",
      "problemMatcher": "$gcc",
      "windows": {
        "args": [
          "--build",
          "--preset",
          "mingw-debug",
          "--target",
          "FluentQtWidgetsGallery",
          "--parallel"
        ]
      }
    },
    {
      "label": "Gallery: Build and Run",
      "type": "shell",
      "command": "open",
      "args": [
        "${workspaceFolder}/build/debug/examples/gallery/FluentQtWidgetsGallery.app"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Gallery: Build",
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}\\build\\examples\\gallery\\FluentQtWidgetsGallery.exe",
        "args": []
      },
      "linux": {
        "command": "${workspaceFolder}/build/debug/examples/gallery/FluentQtWidgetsGallery",
        "args": []
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
