{
  "version": 3,
  "configurePresets": [
    {
      "name": "ninja-debug",
      "displayName": "Ninja Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FQW_BUILD_EXAMPLES": "ON",
        "FQW_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "ninja-release",
      "displayName": "Ninja Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FQW_BUILD_EXAMPLES": "ON",
        "FQW_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "mingw-debug",
      "displayName": "MinGW Debug (Qt mingw_64)",
      "inherits": "ninja-debug",
      "binaryDir": "${sourceDir}/build/mingw",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "ninja-debug"
    },
    {
      "name": "release",
      "configurePreset": "ninja-release"
    },
    {
      "name": "mingw-debug",
      "configurePreset": "mingw-debug"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "ninja-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "mingw-debug",
      "configurePreset": "mingw-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
